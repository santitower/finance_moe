# Finance MoE — Environment Configuration
# Copy to .env and fill in values. Credentials are redacted for safety.

# Primary LLM endpoint (llama.cpp, LM Studio, vLLM, etc.)
LLM_URL=http://127.0.0.1:18434/v1

# Primary model name (local model name, HF ID, or model alias)
# Recommended: Qwen3.5-27B Uncensored (best benchmarks, 16.5 GB Q4 footprint)
# LLM_MODEL=HauhauCS/Qwen3.5-27B-Uncensored-HauhauCS-Aggressive:Q4_K_M

# Uncensored model endpoint (optional — separate port/server for sequential loading)
# Uncensored model uses MoE 35B-A3B (21.2 GB Q4 footprint)
# UNCENSORED_URL=http://127.0.0.1:18435/v1

# Uncensored model name
# UNCENSORED_MODEL=HauhauCS/Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive:Q4_K_M

# Force uncensored model for synthesis
# UNCENSORED=true

# OpenAI-compatible API key (not needed for local, but required by the OpenAI SDK)
OPENAI_API_KEY=not-needed

# Output directory for analysis results
OUTPUT_DIR=data/results
